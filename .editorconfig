# ============================================================================
# 诊断处置标注 —— 仅作用于 FileShare.Desktop 及其 4 个依赖项目
# ----------------------------------------------------------------------------
# 处置原则：
#   1. 只修改「零行为变化且有实际收益」的性能类消息（IDE0330 / CA1861 / CA1870 /
#      CA1826 / CA1859 的局部私有成员），这些已在代码里修掉，故本文件不再抑制。
#   2. 其余消息按类别「明确标注保留」：severity = none 只关闭 IDE / 分析器的
#      info 级提示，不改变编译结果、运行时行为，也不会隐藏任何编译警告。
#   3. 命名规则 / 命名规范类提示（IDE1006、CA1707、CA1716 等）按要求明确排除：
#      本文件不配置、不抑制、不处理。
#   4. dotnet format 的 WHITESPACE 是格式化器差异，不属于诊断规则，无法通过
#      severity 关闭；纯空白重排会产生大范围无意义 diff，故保留现状。
# ============================================================================
[*.cs]
dotnet_diagnostic.IDE0017.severity = none
dotnet_diagnostic.IDE0028.severity = none
dotnet_diagnostic.IDE0057.severity = none
dotnet_diagnostic.IDE0074.severity = none
dotnet_diagnostic.IDE0290.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0301.severity = none
dotnet_diagnostic.IDE0305.severity = none
dotnet_diagnostic.IDE0306.severity = none
dotnet_diagnostic.IDE1006.severity = none

# 类别：性能-误报。日志均为结构化模板 + 廉价属性/局部变量，加 IsEnabled 守卫
#       只会多一次分支并让日志代码膨胀，无实际收益。
dotnet_diagnostic.CA1873.severity = none


# ---------------------------------------------------------------------------
# FileShare.Desktop
# ---------------------------------------------------------------------------
[FileShare.Desktop/**.cs]

# 类别：纯语法 / 写法偏好（集合表达式、主构造函数、集合初始化、null 检查、
#       去除多余赋值、只读字段、Substring 简化）—— 不影响性能与功能，不批量重排。

# ---------------------------------------------------------------------------
# FileShare.Core
# ---------------------------------------------------------------------------
[FileShare.Core/**.cs]
# 类别：性能-误报（同上，结构化日志）。
# 类别：纯语法 / 写法偏好。


# ---------------------------------------------------------------------------
# FileShare.Crypto
# ---------------------------------------------------------------------------
[FileShare.Crypto/**.cs]

# 类别：纯语法 / 写法偏好。


# ---------------------------------------------------------------------------
# LocalSend.Core
# ---------------------------------------------------------------------------
[LocalSend.Core/**.cs]
# 类别：会改变行为 —— CA2016 转发令牌改取消语义；CA1862 换比较方式可能改变
#       大小写行为；CA1859 私有成员具体类型收益可忽略。

# CA1844 已修复：ChunkedStream / ChannelStream 均补上 ReadAsync(Memory<byte>) 重载，
#       读取核心逻辑收敛到 Memory 版、数组版转发，避免基类的数组池租用与多余拷贝。

# 类别：纯语法 / 写法偏好。


# ---------------------------------------------------------------------------
# FileShare.LocalSend
# ---------------------------------------------------------------------------
[FileShare.LocalSend/**.cs]
# 类别：纯语法 / 写法偏好。

