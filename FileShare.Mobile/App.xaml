<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FileShare.Mobile"
             xmlns:helpers="clr-namespace:FileShare.Mobile.Helpers"
             x:Class="FileShare.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 转换器资源 -->
            <helpers:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter" />
            <helpers:StatusToColorConverter x:Key="StatusToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
