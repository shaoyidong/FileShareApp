<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:FileShare.Mobile.Helpers"
             xmlns:vm="clr-namespace:FileShare.Mobile.ViewModels"
             xmlns:coreModel="clr-namespace:FileShare.Core.Models;assembly=FileShare.Core"
             x:Class="FileShare.Mobile.MainPage"
             x:Name="MainPageView"
             Title="局域网文件传输"
             Padding="0" x:DataType="vm:MainPageViewModel"
             >

	<ContentPage.Resources>
		<helpers:StatusToColorConverter x:Key="StatusToColorConverter" />
		<helpers:TransferDirectionToColorConverter x:Key="TransferDirectionToColorConverter"/>
		<!-- 样式定义 -->
		<Style TargetType="Label" x:Key="TitleLabel">
			<Setter Property="FontSize" Value="18" />
			<Setter Property="FontAttributes" Value="Bold" />
			<Setter Property="TextColor" Value="#2c3e50" />
		</Style>

		<Style TargetType="Label" x:Key="StatusLabel">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="TextColor" Value="#3498db" />
		</Style>

		<Style TargetType="Button" x:Key="PrimaryButton">
			<Setter Property="BackgroundColor" Value="#3498db" />
			<Setter Property="TextColor" Value="White" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="15,10" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="FontAttributes" Value="None" />
		</Style>

		<Style TargetType="Button" x:Key="SecondaryButton">
			<Setter Property="BackgroundColor" Value="#95a5a6" />
			<Setter Property="TextColor" Value="White" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="10,6" />
			<Setter Property="FontSize" Value="14" />
		</Style>

		<Style TargetType="Button" x:Key="AcceptButton">
			<Setter Property="BackgroundColor" Value="#2ecc71" />
			<Setter Property="TextColor" Value="White" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="FontSize" Value="14" />
		</Style>

		<Style TargetType="Button" x:Key="RejectButton">
			<Setter Property="BackgroundColor" Value="#f39c12" />
			<Setter Property="TextColor" Value="White" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="FontSize" Value="14" />
		</Style>

		<Style TargetType="Button" x:Key="RemoveButton">
			<Setter Property="BackgroundColor" Value="Transparent" />
			<Setter Property="TextColor" Value="#e74c3c" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="Padding" Value="0,0" />
			<Setter Property="FontSize" Value="15" />					
			<Setter Property="MinimumHeightRequest" Value="0"/>
			<Setter Property="MinimumWidthRequest" Value="0"/>
		</Style>
	</ContentPage.Resources>

	<ScrollView>
		<StackLayout Padding="0" Spacing="13">
			<!-- 状态栏 -->
			<Border Margin="16,8,16,0"
        Padding="12"        
        Stroke="Transparent" 
                StrokeThickness="0"
        StrokeShape="RoundRectangle 12">
				<Border.Shadow >
					<Shadow Brush="#000000" Opacity="0.1" Radius="4" Offset="0,2" />
				</Border.Shadow>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Label Text="{Binding StatusMessage}" 
           Style="{StaticResource StatusLabel}" 
           VerticalOptions="Center" 
           HorizontalOptions="Start" 
           LineBreakMode="TailTruncation" />
					<!--<Button Text="刷新设备" Grid.Column="1"
            Command="{Binding RefreshDevicesCommand}"
            IsEnabled="{Binding IsNotScanning}"
            Margin="10,0,0,0" 
            VerticalOptions="Center" 
            HorizontalOptions="End" 
            Style="{StaticResource SecondaryButton}" 
            WidthRequest="120" />-->
				</Grid>
			</Border>

			<!-- 设备列表 -->
			<Border Margin="16,0,16,0" Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12">
				<Border.Shadow >
					<Shadow Brush="#000000" Opacity="0.1" Radius="4" Offset="0,2" />
				</Border.Shadow>
				<StackLayout >
					<Label Text="可用设备" 
                       Style="{StaticResource TitleLabel}" 
                       Margin="0,0,0,12" />

					<CollectionView ItemsSource="{Binding Devices}" 
                              SelectedItem="{Binding SelectedDevice}"
                              SelectionMode="Single" 
                              BackgroundColor="Transparent" 
                              HeightRequest="200">
						<CollectionView.ItemsLayout>
							<LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
						</CollectionView.ItemsLayout>
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="coreModel:DeviceInfo">
								<Border BackgroundColor="#ecf0f1" 
                                   StrokeShape="RoundRectangle 12" 
                                   Padding="16"                                   
                                   Stroke="#bdc3c7" 
                                   StrokeThickness="1">
									<StackLayout Orientation="Vertical" Spacing="6">
										<Grid ColumnDefinitions="*,Auto">
											<Label Text="{Binding DeviceName}" 
                                               FontSize="16" 
                                               FontAttributes="Bold" 
                                               TextColor="#2c3e50" />
											<Border Grid.Column="1" StrokeShape="RoundRectangle 8" BackgroundColor="#3498db" Padding="6,2"    >
												<Label Text="{Binding DeviceType}" 
													   FontSize="12" 
													   TextColor="#7f8c8d" 
													   HorizontalOptions="End" 
													   VerticalOptions="Center" />
											</Border>
										</Grid>
										<Label Text="{Binding IpAddress}" 
                                           FontSize="14" 
                                           TextColor="#7f8c8d" />
									</StackLayout>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
						<CollectionView.EmptyView>
							<Label Text="暂无可用设备，请点击刷新按钮" 
                               FontSize="14" 
                               TextColor="#95a5a6" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" 
                               Margin="0,40,0,0" />
						</CollectionView.EmptyView>
					</CollectionView>

					<Button Text="发送文件" 
                        Command="{Binding SendFileCommand}"
                        HorizontalOptions="Fill"
                        Margin="0,16,0,0"
                        Style="{StaticResource PrimaryButton}" 
                        IsEnabled="{Binding SelectedDevice}" />
				</StackLayout>
			</Border>
			<!-- 传输任务 -->
			<Border Margin="16,0,16,32" Padding="16" BackgroundColor="White">
				<Border.Shadow >
					<Shadow Brush="#000000" Opacity="0.1" Radius="4" Offset="0,2" />
				</Border.Shadow>
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="12" />
				</Border.StrokeShape>
				<StackLayout >
					<Label Text="传输任务" 
                       Style="{StaticResource TitleLabel}" 
                       Margin="0,0,0,12" />

					<!-- 传输任务列表 -->
					<CollectionView ItemsSource="{Binding TransferTasks}"                               
                              BackgroundColor="Transparent">
						<CollectionView.ItemsLayout>
							<LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
						</CollectionView.ItemsLayout>
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="vm:FileTransferViewModel">
								<Border BackgroundColor="#ecf0f1" 
                                   StrokeShape="RoundRectangle 12" 
                                   Padding="10,12,6,12"                                    
                                   Stroke="#bdc3c7" 
                                   StrokeThickness="1">
									<StackLayout Spacing="10">
										<Grid ColumnDefinitions="Auto,*,Auto">
											<Label Text="{Binding DirectionText,StringFormat='({0})'}" 
												   TextColor="{Binding Direction, Converter={StaticResource TransferDirectionToColorConverter}}"
												   FontAttributes="None" 
												   FontSize="16" />
											<Label Text="{Binding FileName}" Grid.Column="1"
                                               FontAttributes="Bold" Margin="0,0,0,5"
                                               FontSize="16" 
                                               TextColor="#2c3e50" 
                                               LineBreakMode="TailTruncation" />
											<Button Text="✕"  Grid.Column="2" VerticalOptions="Start"
													Command="{Binding Path=RemoveTransferCommand, Source={RelativeSource AncestorType={x:Type vm:MainPageViewModel}}, x:DataType='vm:MainPageViewModel'}"
													CommandParameter="{Binding}" 
													Style="{StaticResource RemoveButton}"/>
										</Grid>
										<Grid ColumnDefinitions="*,Auto">
											<StackLayout Grid.Column="1" Orientation="Horizontal">
												<Label  Text="{Binding FormattedTransferredSize,StringFormat='{0}'}" 
														FontSize="14" 
														TextColor="#7f8c8d" />
												<Label  Text="{Binding FormattedFileSize,StringFormat='/{0}'}" 
														FontSize="14" 
														TextColor="#7f8c8d" />												
											</StackLayout>											
											<Label Grid.Column="0" Text="{Binding StatusText}" 
                                               FontSize="14" 
                                               FontAttributes="None" 
                                               TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                                               HorizontalOptions="Start" />
										</Grid>

										<Grid ColumnDefinitions="*,Auto">
											<ProgressBar Progress="{Binding ProgressFraction}" 
															 ProgressColor="#3498db"
															 HeightRequest="10"
															 BackgroundColor="#bdc3c7"/>
											<Label Grid.Column="1" Text="{Binding ProgressFraction, StringFormat='{0:P1}'}" 
													   FontSize="14"
													   TextColor="#3498db" 
													   HorizontalOptions="End" 
													   Margin="10,0,0,0" />
										</Grid>										
									</StackLayout>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
						<CollectionView.EmptyView>
							<Label Text="暂无传输任务" 
                               FontSize="14" 
                               TextColor="#95a5a6" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" 
                               Margin="0,40,0,0" />
						</CollectionView.EmptyView>
					</CollectionView>
				</StackLayout>
			</Border>
		</StackLayout>
	</ScrollView>
</ContentPage>
