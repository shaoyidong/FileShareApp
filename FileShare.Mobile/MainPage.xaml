<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FileShare.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:coreModel="clr-namespace:FileShare.Core.Models;assembly=FileShare.Core"
    xmlns:helpers="clr-namespace:FileShare.Mobile.Helpers"
    xmlns:vm="clr-namespace:FileShare.Mobile.ViewModels"
    x:Name="MainPageView"
    Title="局域网文件传输"
    Padding="0"
    x:DataType="vm:MainPageViewModel">

    <ContentPage.Resources>
        <helpers:StatusToColorConverter x:Key="StatusToColorConverter" />
        <helpers:TransferDirectionToColorConverter x:Key="TransferDirectionToColorConverter" />
        <!--  样式定义  -->
        <Style x:Key="TitleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <!--<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />-->
        </Style>

        <Style x:Key="StatusLabel" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            <!--<Setter Property="TextColor" Value="White" />-->
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="None" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}" />
            <!--<Setter Property="TextColor" Value="White" />-->
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="AcceptButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
            <!--<Setter Property="TextColor" Value="White" />-->
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="RejectButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
            <!--<Setter Property="TextColor" Value="White" />-->
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#e74c3c" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>

        <!--  状态栏  -->
        <Border
            Grid.Row="0"
            Margin="16,8,16,13"
            Padding="12"
            Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},
                                         Dark={StaticResource DarkSecondaryBackground}}"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="0">
            <Border.Shadow>
                <Shadow
                    Brush="{AppThemeBinding Light=#000000,
                                            Dark=#FFFFFF}"
                    Opacity="0.1"
                    Radius="4"
                    Offset="0,2" />
            </Border.Shadow>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label
                    HorizontalOptions="Start"
                    LineBreakMode="TailTruncation"
                    Style="{StaticResource StatusLabel}"
                    Text="{Binding StatusMessage}"
                    VerticalOptions="Center" />
                <!--<Button Text="刷新设备" Grid.Column="1"
            Command="{Binding RefreshDevicesCommand}"
            IsEnabled="{Binding IsNotScanning}"
            Margin="10,0,0,0"
            VerticalOptions="Center"
            HorizontalOptions="End"
            Style="{StaticResource SecondaryButton}"
            WidthRequest="120" />-->
            </Grid>
        </Border>

        <!--  设备列表  -->
        <Border
            Grid.Row="1"
            Margin="16,0,16,13"
            Padding="16"
            Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},
                                         Dark={StaticResource DarkSecondaryBackground}}"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="0">
            <Border.Shadow>
                <Shadow
                    Brush="{AppThemeBinding Light=#000000,
                                            Dark=#FFFFFF}"
                    Opacity="0.1"
                    Radius="4"
                    Offset="0,2" />
            </Border.Shadow>
            <Grid RowDefinitions="auto,*,auto">
                <Label
                    Margin="0,0,0,12"
                    Style="{StaticResource TitleLabel}"
                    Text="可用设备" />

                <CollectionView
                    Grid.Row="1"
                    BackgroundColor="Transparent"
                    ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding SelectedDevice}"
                    SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            HorizontalItemSpacing="5"
                            Orientation="Vertical"
                            Span="2"
                            VerticalItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="coreModel:DeviceInfo">
                            <Border
                                Padding="10"
                                Background="{AppThemeBinding Light={StaticResource LightBackground},
                                                             Dark={StaticResource DarkBackground}}"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200},
                                                         Dark={StaticResource Gray600}}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                                <StackLayout Orientation="Vertical" Spacing="3">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="{Binding DeviceName}"
                                        TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground},
                                                                    Dark={StaticResource LightOnDarkBackground}}" />
                                    <Label
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        Text="{Binding DeviceType}"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                    Dark={StaticResource Gray400}}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="14"
                                        Text="{Binding IpAddress}"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                                    Dark={StaticResource PrimaryDark}}" />
                                </StackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label
                            Margin="0,40,0,0"
                            FontSize="14"
                            HorizontalOptions="Center"
                            Text="暂无可用设备，请点击刷新按钮"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                        Dark={StaticResource Gray400}}"
                            VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                </CollectionView>

                <Button
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    Command="{Binding SendFileCommand}"
                    HorizontalOptions="Fill"
                    IsEnabled="{Binding SelectedDevice}"
                    Style="{StaticResource PrimaryButton}"
                    Text="发送文件" />
            </Grid>
        </Border>

        <!--  传输任务  -->
        <Border
            Grid.Row="2"
            Margin="16,0,16,13"
            Padding="16"
            Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},
                                         Dark={StaticResource DarkSecondaryBackground}}">
            <Border.Shadow>
                <Shadow
                    Brush="{AppThemeBinding Light=#000000,
                                            Dark=#FFFFFF}"
                    Opacity="0.1"
                    Radius="4"
                    Offset="0,2" />
            </Border.Shadow>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Label
                    Margin="0,0,0,12"
                    Style="{StaticResource TitleLabel}"
                    Text="传输任务" />
                <!--  传输任务列表  -->
                <CollectionView
                    Grid.Row="1"
                    BackgroundColor="Transparent"
                    ItemsSource="{Binding TransferTasks}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="5" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileTransferViewModel">
                            <Border
                                Padding="10,10,10,8"
                                Background="{AppThemeBinding Light={StaticResource LightBackground},
                                                             Dark={StaticResource DarkBackground}}"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200},
                                                         Dark={StaticResource Gray600}}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                                <StackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Label
                                            FontAttributes="None"
                                            FontSize="16"
                                            Text="{Binding DirectionText, StringFormat='({0})'}"
                                            TextColor="{Binding Direction, Converter={StaticResource TransferDirectionToColorConverter}}" />
                                        <Label
                                            Grid.Column="1"
                                            Margin="0,0,0,5"
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding FileName}"
                                            TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground},
                                                                        Dark={StaticResource LightOnDarkBackground}}" />
                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding Path=RemoveTransferCommand, Source={RelativeSource AncestorType={x:Type vm:MainPageViewModel}}, x:DataType='vm:MainPageViewModel'}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RemoveButton}"
                                            Text="✕"
                                            VerticalOptions="Start" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackLayout Grid.Column="1" Orientation="Horizontal">
                                            <Label
                                                FontSize="14"
                                                Text="{Binding FormattedTransferredSize, StringFormat='{0}'}"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                            Dark={StaticResource Gray400}}" />
                                            <Label
                                                FontSize="14"
                                                Text="{Binding FormattedFileSize, StringFormat='/ {0}'}"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                            Dark={StaticResource Gray400}}" />
                                        </StackLayout>
                                        <Label
                                            Grid.Column="0"
                                            FontAttributes="None"
                                            FontSize="14"
                                            HorizontalOptions="Start"
                                            Text="{Binding StatusText}"
                                            TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <ProgressBar
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200},
                                                                              Dark={StaticResource Gray600}}"
                                            HeightRequest="10"
                                            Progress="{Binding ProgressFraction}"
                                            ProgressColor="{AppThemeBinding Light={StaticResource Primary},
                                                                            Dark={StaticResource PrimaryDark}}" />
                                        <Label
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            FontSize="14"
                                            HorizontalOptions="End"
                                            Text="{Binding ProgressFraction, StringFormat='{0:P1}'}"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                                        Dark={StaticResource PrimaryDark}}" />
                                    </Grid>
                                </StackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label
                            Margin="0,40,0,0"
                            FontSize="14"
                            HorizontalOptions="Center"
                            Text="暂无传输任务"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                        Dark={StaticResource Gray400}}"
                            VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>