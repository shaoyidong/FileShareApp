<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileShare.Desktop.App"
             xmlns:local="using:FileShare.Desktop"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Resources>
        <ResourceDictionary>
            <!-- Status Colors -->
            <Color x:Key="StatusCompleted">#2ecc71</Color>
            <Color x:Key="StatusFailed">#e74c3c</Color>
            <Color x:Key="StatusTransferring">#3498db</Color>
            <Color x:Key="StatusPending">#f39c12</Color>
            <Color x:Key="StatusCancelled">#95a5a6</Color>
            <Color x:Key="StatusUnknown">#7f8c8d</Color>

            <!-- Direction Colors -->
            <Color x:Key="DirectionSend">#449c12</Color>
            <Color x:Key="DirectionReceive">#3498db</Color>
            <Color x:Key="DirectionUnknown">#7f8c8d</Color>

            <FontFamily x:Key="FluentIcons">avares://FileShare.Desktop/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
    
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>