<UserControl
    x:Class="FileShare.Desktop.Views.ReceiveRequestView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Shyd.Prism.Localization"
    xmlns:vm="using:FileShare.Desktop.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="vm:ReceiveRequestViewModel"
    Width="440"
    d:DesignWidth="440"
    mc:Ignorable="d">

    <!--  内容弹窗（仿 Prism ShowDialog）：本视图由 DialogService 放进 DialogWindow 宿主显示，
         标题栏由宿主窗口承担（Title = ReceiveRequestViewModel.Title），视图只保留内容与按钮栏  -->
    <Grid RowDefinitions="*,Auto">

        <StackPanel
            Grid.Row="0"
            Margin="14"
            Spacing="10">
            <TextBlock
                TextWrapping="Wrap"
                Text="{Binding SenderText}" />

            <Border Padding="10" Classes="panel">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontWeight="Bold"
                        TextWrapping="Wrap"
                        Text="{Binding FileText}" />
                    <TextBlock
                        Classes="muted"
                        Text="{Binding SizeText}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="label" Text="{loc:Tr '保存到'}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="muted"
                    TextWrapping="Wrap"
                    Text="{Binding DirectoryText}" />
            </StackPanel>

            <CheckBox
                IsChecked="{Binding AlwaysAccept}"
                Content="{loc:Tr '以后自动接收此设备的文件（加入收藏）'}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="10,8"
            Classes="statusbar">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="6">
                <Button
                    MinWidth="84"
                    Classes="accent"
                    Command="{Binding AcceptCommand}"
                    Content="{loc:Tr '接收'}" />
                <Button
                    MinWidth="84"
                    Command="{Binding DeclineCommand}"
                    Content="{loc:Tr '拒绝'}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
