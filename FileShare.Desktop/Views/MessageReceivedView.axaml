<UserControl
    x:Class="FileShare.Desktop.Views.MessageReceivedView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Shyd.Prism.Localization"
    xmlns:vm="using:FileShare.Desktop.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="vm:MessageReceivedViewModel"
    Width="460"
    d:DesignWidth="460"
    mc:Ignorable="d">

    <!--  内容弹窗（仿 Prism ShowDialog）：本视图由 DialogService 放进 DialogWindow 宿主显示；
         宿主以非激活方式显示（不抢焦点）由 MessageReceivedViewModel 通过
         IDialogAwareWindowOptions 配置，视图只保留内容与按钮栏  -->
    <Grid RowDefinitions="*,Auto">

        <StackPanel
            Grid.Row="0"
            Margin="14"
            Spacing="10">
            <TextBlock
                Classes="muted"
                TextWrapping="Wrap"
                Text="{Binding SenderText}" />

            <Border Padding="10" Classes="panel">
                <ScrollViewer
                    MaxHeight="320"
                    VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock
                        TextWrapping="Wrap"
                        Text="{Binding Message}" />
                </ScrollViewer>
            </Border>

            <TextBlock
                x:Name="HintText"
                Classes="muted"
                IsVisible="False" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="10,8"
            Classes="statusbar">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="6">
                <Button
                    MinWidth="96"
                    Classes="accent"
                    Click="OnCopyClick"
                    Content="{loc:Tr '复制全文'}" />
                <Button
                    MinWidth="84"
                    Command="{Binding CloseCommand}"
                    Content="{loc:Tr '关闭'}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
