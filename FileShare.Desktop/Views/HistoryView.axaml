<UserControl
    x:Class="FileShare.Desktop.Views.HistoryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FileShare.Desktop.Localization"
    xmlns:converters="using:FileShare.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="using:FileShare.Desktop.Assets.Fonts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FileShare.Desktop.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="960"
    x:CompileBindings="True"
    x:DataType="vm:HistoryViewModel"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*,Auto">

        <!--  顶部工具栏  -->
        <Border Grid.Row="0" Classes="toolbar" Padding="8,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        Classes="icon"
                        Command="{Binding BackCommand}"
                        ToolTip.Tip="{loc:Tr '返回'}">
                        <TextBlock
                            Classes="iconGlyph"
                            Text="{x:Static fonts:FluentUI.arrow_left_24_regular}" />
                    </Button>
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="h1"
                        Text="{loc:Tr '传输历史'}" />
                    <Border
                        Height="18"
                        VerticalAlignment="Center"
                        Classes="separator" />
                    <Button
                        MinWidth="0"
                        Content="{loc:Tr '全部'}"
                        Command="{Binding ShowAllCommand}" />
                    <Button
                        MinWidth="0"
                        Content="{loc:Tr '仅接收'}"
                        Command="{Binding ShowReceivedCommand}" />
                    <Button
                        MinWidth="0"
                        Content="{loc:Tr '仅发送'}"
                        Command="{Binding ShowSentCommand}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="muted"
                        Text="{Binding HistoryCountText}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Classes="icon"
                    Command="{Binding DeleteHistoryCommand}"
                    ToolTip.Tip="{loc:Tr '清空全部记录'}">
                    <TextBlock
                        Classes="iconGlyph"
                        Text="{x:Static fonts:FluentUI.delete_24_regular}" />
                </Button>
            </Grid>
        </Border>

        <!--  历史列表  -->
        <Border
            Grid.Row="1"
            Margin="8"
            Padding="8"
            Classes="panel">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ReceiveHistory}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid
                                    VerticalAlignment="Top"
                                    ColumnSpacing="6"
                                    Columns="2"
                                    RowSpacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Classes="card">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!--  文件图标 / 缩略图  -->
                                        <Border
                                            Grid.Column="0"
                                            Width="44"
                                            Height="44"
                                            Margin="0,0,10,0"
                                            Background="#F4F4F4"
                                            BorderBrush="#DDDDDD"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                            <ContentControl
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Content="{Binding}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Image
                                                                Width="40"
                                                                Height="40"
                                                                IsVisible="{Binding, Converter={x:Static converters:FileTypeToImageSourceConverter.Instance},
                                                                                     ConverterParameter=isImage}"
                                                                Source="{Binding, Converter={x:Static converters:FileTypeToImageSourceConverter.Instance}, ConverterParameter=image}"
                                                                Stretch="Uniform" />
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontFamily="avares://FileShare.Desktop/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons"
                                                                FontSize="28"
                                                                Foreground="#4A7EBB"
                                                                IsVisible="{Binding, Converter={x:Static converters:FileTypeToImageSourceConverter.Instance},
                                                                                     ConverterParameter=isIcon}"
                                                                Text="{Binding, Converter={x:Static converters:FileTypeToImageSourceConverter.Instance}, ConverterParameter=icon}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                        </Border>

                                        <!--  文件信息  -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Classes="muted" Text="{Binding Direction, Converter={x:Static converters:TransferEnumToTextConverter.Instance}, ConverterParameter=direction}" />
                                                <TextBlock Classes="accent" Text="{Binding Status, Converter={x:Static converters:TransferEnumToTextConverter.Instance}}" IsVisible="{Binding IsSuccess}" />
                                                <TextBlock Classes="danger" Text="{Binding Status, Converter={x:Static converters:TransferEnumToTextConverter.Instance}}" IsVisible="{Binding !IsSuccess}" />
                                            </StackPanel>
                                            <TextBlock
                                                FontWeight="Bold"
                                                Text="{Binding FileName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                Classes="muted"
                                                TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding CreatedAt, StringFormat='yyyy/MM/dd HH:mm'}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{Binding FileSize, Mode=OneWay, Converter={x:Static converters:FileSizeToFormatFileSizeConverter.Instance}}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{Binding PeerDisplayName}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!--  更多操作  -->
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Classes="icon"
                                            Tag="{Binding}">
                                            <TextBlock
                                                Classes="iconGlyph"
                                                Text="{x:Static fonts:FluentUI.more_vertical_24_regular}" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem
                                                        Command="{Binding $parent[UserControl].DataContext.OpenFileCommand}"
                                                        CommandParameter="{Binding $parent[Button].Tag}"
                                                        Header="{loc:Tr '打开文件'}"
                                                        IsEnabled="{Binding HasFile}" />
                                                    <MenuItem
                                                        Command="{Binding $parent[UserControl].DataContext.ShowInFileManagerCommand}"
                                                        CommandParameter="{Binding $parent[Button].Tag}"
                                                        Header="{loc:Tr '在文件管理器中显示'}"
                                                        IsEnabled="{Binding HasFile}" />
                                                    <MenuItem
                                                        Command="{Binding $parent[UserControl].DataContext.DeleteSingleHistoryCommand}"
                                                        CommandParameter="{Binding $parent[Button].Tag}"
                                                        Header="{loc:Tr '从历史记录中删除'}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  加载遮罩  -->
                <Border Background="#FFFFFF" IsVisible="{Binding IsLoading}" Opacity="0.75">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="accent"
                        Text="{loc:Tr '加载中...'}" />
                </Border>
            </Grid>
        </Border>

        <!--  状态栏  -->
        <Border Grid.Row="2" Padding="8,3" Classes="statusbar">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="muted" Text="{Binding FilterText, StringFormat='筛选：{0}'}" />
                <TextBlock Classes="muted" Text="{Binding HistoryCountText}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
