<UserControl
    x:Class="FileShare.Desktop.Views.HistoryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:FileShare.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="using:FileShare.Desktop.Assets.Fonts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FileShare.Desktop.ViewModels"
    x:CompileBindings="True"
    x:DataType="vm:HistoryViewModel"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Button.secondary-button">
            <Setter Property="Background" Value="#E6E6E6" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style Selector="Button.icon-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="Button.fluentIcon-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="24" />
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Background" Value="#E6E6E6" />
        </Style>
    </UserControl.Styles>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="10"
            Background="#F5F5F5"
            CornerRadius="12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button
                    Classes="fluentIcon-button"
                    Command="{Binding BackCommand}"
                    Content="{x:Static fonts:FluentUI.arrow_left_24_regular}"
                    ToolTip.Tip="返回" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="历史" />
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Classes="fluentIcon-button"
                        Command="{Binding DeleteHistoryCommand}"
                        Content="{x:Static fonts:FluentUI.delete_24_regular}"
                        ToolTip.Tip="清空记录" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  History List  -->
        <Border
            Grid.Row="1"
            Padding="16"
            Background="#F5F5F5"
            CornerRadius="12">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ReceiveHistory}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid
                                    VerticalAlignment="Top"
                                    ColumnSpacing="8"
                                    Columns="2"
                                    RowSpacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="12"
                                    Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!--  File Preview / Icon  -->
                                        <Border
                                            Grid.Column="0"
                                            Width="48"
                                            Height="48"
                                            Margin="0,0,12,0"
                                            Background="#F0F0F0"
                                            CornerRadius="4">
                                            <ContentControl
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Content="{Binding}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Image
                                                                Width="48"
                                                                Height="48"
                                                                IsVisible="{Binding, Converter={x:Static converters:FileTypeToImageSourceConverter.Instance},
                                                                                     ConverterParameter=isImage}"
                                                                Source="{Binding, Converter={x:Static converters:FileTypeToImageSourceConverter.Instance}}"
                                                                Stretch="Uniform" />
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontFamily="{StaticResource FluentIcons}"
                                                                FontSize="48"
                                                                IsVisible="{Binding, Converter={x:Static converters:FileTypeToImageSourceConverter.Instance},
                                                                                     ConverterParameter=isIcon}"
                                                                Text="{Binding, Converter={x:Static converters:FileTypeToImageSourceConverter.Instance}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                        </Border>

                                        <!--  File Info  -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#333333"
                                                Text="{Binding FileName}" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="12"
                                                Foreground="#666666">
                                                <Run Text="{Binding CreatedAt, StringFormat='yyyy/MM/dd HH:mm'}" />
                                                -<Run Text="{Binding FileSize, Mode=OneWay, Converter={x:Static converters:FileSizeToFormatFileSizeConverter.Instance}}" />
                                                -<Run Text="{Binding SenderDeviceName}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!--  Context Menu Button  -->
                                        <Button
                                            Grid.Column="2"
                                            Classes="fluentIcon-button"
                                            Content="{x:Static fonts:FluentUI.more_vertical_24_regular}"
                                            FontFamily="{StaticResource FluentIcons}"
                                            Tag="{Binding}">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem
                                                        Command="{Binding $parent[UserControl].DataContext.OpenFileCommand}"
                                                        CommandParameter="{Binding $parent[Button].Tag}"
                                                        Header="打开文件" />
                                                    <MenuItem
                                                        Command="{Binding $parent[UserControl].DataContext.ShowInFileManagerCommand}"
                                                        CommandParameter="{Binding $parent[Button].Tag}"
                                                        Header="在文件管理器中显示" />
                                                    <MenuItem
                                                        Command="{Binding $parent[UserControl].DataContext.DeleteSingleHistoryCommand}"
                                                        CommandParameter="{Binding $parent[Button].Tag}"
                                                        Header="从历史记录中删除" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  Empty State  -->
                <!--<TextBlock Grid.Row="0" Text="暂无接收历史" FontSize="14" Foreground="#999999" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ReceiveHistory.Count, Converter={x:Static conv:BoolConverters.NotEqual}, ConverterParameter=0}" />-->

                <!--  Loading Indicator  -->
                <Border
                    Grid.Row="0"
                    Background="White"
                    IsVisible="{Binding IsLoading}"
                    Opacity="0.8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#0078D4"
                        Text="加载中..." />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>