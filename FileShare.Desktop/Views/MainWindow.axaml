<Window
x:Class="FileShare.Desktop.Views.MainWindow"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:FileShare.Desktop.ViewModels"
xmlns:converters="using:FileShare.Desktop.Converters"
Title="局域网文件传输"
d:DesignHeight="600"
d:DesignWidth="900"
x:DataType="vm:MainWindowViewModel"
Icon="/Assets/avalonia-logo.ico"
mc:Ignorable="d">
	<Window.Styles>
		<Style Selector="Button.red-button">
			<Setter Property="Foreground" Value="Red" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
		</Style>
		<Style Selector="Button.red-button:pointerover /template/ ContentPresenter">
			<Setter Property="TextBlock.Foreground" Value="Red" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.red-button:pressed /template/ ContentPresenter">
			<Setter Property="TextBlock.Foreground" Value="Red" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.primary-button">
			<Setter Property="Background" Value="#0078D4" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="FontSize" Value="14" />
		</Style>
		<Style Selector="Button.secondary-button">
			<Setter Property="Background" Value="#E6E6E6" />
			<Setter Property="Foreground" Value="#333333" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="8,4" />
			<Setter Property="FontSize" Value="12" />
		</Style>
		<Style Selector="Button.accept-button">
			<Setter Property="Background" Value="#0078D4" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="10,6" />
			<Setter Property="FontSize" Value="12" />
		</Style>
		<Style Selector="Button.reject-button">
			<Setter Property="Background" Value="#E6E6E6" />
			<Setter Property="Foreground" Value="#333333" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="10,6" />
			<Setter Property="FontSize" Value="12" />
		</Style>
	</Window.Styles>
	<Design.DataContext>
		<!--
		This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
		-->
		<vm:MainWindowViewModel />
	</Design.DataContext>
	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="0.3*" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!-- 状态栏 -->
		<Border Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
				Padding="10"
				BorderBrush="Transparent"
				BorderThickness="0"
				CornerRadius="12"
				Background="#F5F5F5">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock Text="{Binding StatusMessage}"
						   FontSize="14"
						   Foreground="#0078D4"
						   VerticalAlignment="Center"
						   HorizontalAlignment="Left" />
			</Grid>
		</Border>

		<!-- 设备列表 -->
		<Border Grid.Row="1" Grid.Column="0" Margin="0,0,12,0"
				Padding="16"
				CornerRadius="12"
				Background="#F5F5F5">
			<Grid RowDefinitions="Auto,*,Auto">
				<TextBlock Text="可用设备"
						   FontSize="16"
						   FontWeight="Bold"
						   Margin="0,0,0,12" />
				<ListBox Grid.Row="1" 
				 SelectedItem="{Binding SelectedDevice}"
				 ItemsSource="{Binding Devices}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border	Background="White"						
									Padding="12"
									Margin="-11,-8,-11,-8"
									BorderThickness="0,0,0,1"
									BorderBrush="#E0E0E0">
								<StackPanel>
									<TextBlock Text="{Binding DeviceName}"
											   FontSize="14"
											   FontWeight="Bold"
											   Foreground="#333333" />
									<TextBlock Text="{Binding DeviceType}"
											   FontSize="12"
											   Foreground="#666666"
											   Margin="0,4,0,0" />
									<TextBlock Text="{Binding IpAddress}"
											   FontSize="12"
											   Foreground="#0078D4"
											   Margin="0,4,0,0" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				<ListBox.Styles>
					<Style Selector="ListBoxItem:selected">
						<Setter Property="Background" Value="#4080FF" />
						<Setter Property="Foreground" Value="White" />
					</Style>
				</ListBox.Styles>
				</ListBox>
				<Button Grid.Row="2"
						Content="发送文件"
						Command="{Binding SendFileCommand}"
						IsEnabled="{Binding SelectedDevice}"
						HorizontalAlignment="Stretch"
						HorizontalContentAlignment="Center"
						Margin="0,8,0,0"
						Classes="primary-button" />
			</Grid>
		</Border>

		<!-- 传输任务 -->
		<Border Grid.Row="1" Grid.Column="1"
				Padding="16"
				CornerRadius="12"
				Background="#F5F5F5">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<TextBlock Text="传输任务"
						   FontSize="16"
						   FontWeight="Bold"
						   Margin="0,0,0,12" />
				<ItemsControl Grid.Row="1" ItemsSource="{Binding TransferTasks}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="3"/>	
						</ItemsPanelTemplate>	
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,0,0"
									Padding="12"									
									Background="White"
									BorderThickness="1"
									BorderBrush="#E0E0E0">
								<StackPanel>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<TextBlock Text="{Binding DirectionText,StringFormat='({0})'}"
												   FontSize="14"
												   VerticalAlignment="Center"
												   Foreground="{Binding Direction, Converter={x:Static converters:TransferDirectionToColorConverter.Instance}}" />
										<TextBlock Grid.Column="1"
												   Text="{Binding FileName}"
												   FontWeight="Bold"
												   FontSize="14"
												   VerticalAlignment="Center"
												   Foreground="#333333"
												   Margin="8,0,0,0" />
										<Button Grid.Column="2"
												Content="✕" 
												FontSize="20"
												Margin="0,-15,-10,0"
												VerticalAlignment="Center"
												Command="{Binding $parent[Window].DataContext.RemoveTransferCommand}"
												CommandParameter="{Binding}"
                                                ToolTip.Tip="移除此任务"
												Classes="red-button" />
									</Grid>
									<Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
										<StackPanel Grid.Column="1" Orientation="Horizontal">
											<TextBlock Text="{Binding FormattedTransferredSize}"
													   FontSize="12"
													   Foreground="#666666" />
											<TextBlock Text="/"
													   FontSize="12"
													   Foreground="#666666"
													   Margin="2,0" />
											<TextBlock Text="{Binding FormattedFileSize}"
													   FontSize="12"
													   Foreground="#666666" />
										</StackPanel>
										<TextBlock Grid.Column="0"
												   Text="{Binding StatusText}"
												   FontSize="12"
												   Foreground="{Binding Status, Converter={x:Static converters:StatusToColorConverter.Instance}}" />
									</Grid>
									<Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
										<ProgressBar Grid.Column="0"
													   Height="8"
													   Maximum="100"
													   Value="{Binding ProgressPercentage}"
													   Background="#E0E0E0"
													   Foreground="#0078D4" />
										<TextBlock Grid.Column="1"
												   Text="{Binding ProgressPercentage, StringFormat={}{0:F1}%}"
												   FontSize="12"
												   Foreground="#0078D4"
												   Margin="8,0,0,0" />
									</Grid>
									<!-- 只有待处理且接收的任务才显示接受/拒绝按钮 -->
									<Grid Margin="0,8,0,0" ColumnDefinitions="Auto,Auto" IsVisible="{Binding ShowAcceptReject}">									
										<Button Grid.Column="0"
												Content="接受"
												Command="{Binding $parent[Window].DataContext.AcceptTransferCommand}"
												CommandParameter="{Binding}"
												Margin="0,0,8,0"
												Classes="accept-button" />
										<Button Grid.Column="1"
												Content="拒绝"
												Command="{Binding $parent[Window].DataContext.RejectTransferCommand}"
												CommandParameter="{Binding}"
												Classes="reject-button" />
									</Grid>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Grid>
		</Border>
	</Grid>
</Window>
