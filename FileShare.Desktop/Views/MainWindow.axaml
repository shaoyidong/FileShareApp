<Window
x:Class="FileShare.Desktop.Views.MainWindow"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:FileShare.Desktop.ViewModels"
xmlns:converters="using:FileShare.Desktop.Converters"
Title="FileShare.Desktop"
d:DesignHeight="450"
d:DesignWidth="800"
x:DataType="vm:MainWindowViewModel"
Icon="/Assets/avalonia-logo.ico"
mc:Ignorable="d">
	<Window.Styles>
		<Style Selector="Button.red-button">
			<Setter Property="Foreground" Value="Red" />
		</Style>
		<Style Selector="Button.red-button:pointerover /template/ ContentPresenter">
			<Setter Property="TextBlock.Foreground" Value="Red" />
		</Style>
		<Style Selector="Button.red-button:pressed /template/ ContentPresenter">
			<Setter Property="TextBlock.Foreground" Value="Red" />
		</Style>
	</Window.Styles>
	<Design.DataContext>
		<!--
		This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
		-->
		<vm:MainWindowViewModel />
	</Design.DataContext>
	<!--<TextBlock
	HorizontalAlignment="Center"
	VerticalAlignment="Center"
	Text="{Binding Greeting}" />-->
	<Grid
	Margin="10"
	ColumnDefinitions="1*"
	RowDefinitions="Auto,1*,1*,1*">		
		<StackPanel
		Grid.Row="0"
		Orientation="Horizontal">
			<Button			
			Command="{Binding RefreshDevicesCommand}"
			Content="刷新设备"
			IsEnabled="{Binding !IsScanning}" />
			<TextBlock
			Margin="10,0,0,0"
			FontSize="14"
			VerticalAlignment="Center"
			Foreground="DarkBlue"
			Text="{Binding StatusMessage}" />			
		</StackPanel>
		<!--  设备列表  -->
		<Grid
		Grid.Row="1"
		Margin="0,10,0,10"
		RowDefinitions="Auto,1*">
			<!--<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="1*" />
			</Grid.RowDefinitions>-->
			<TextBlock
			Margin="0,0,0,5"
			FontSize="16"
			FontWeight="Bold"
			Text="可用设备" />
			<ListBox
			Grid.Row="1"
			ItemsSource="{Binding Devices}"
			SelectedItem="{Binding SelectedDevice}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Margin="5" Orientation="Horizontal">
							<TextBlock FontWeight="Bold" Text="{Binding DeviceName}" />
							<TextBlock Margin="5,0,0,0" Text=" ({Binding DeviceType})" />
							<TextBlock Margin="5,0,0,0" Text=" - " />
							<TextBlock Margin="0,0,0,0" Text="{Binding IpAddress}" />
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
				<ListBox.Styles>
					<Style Selector="ListBoxItem:selected">
						<Setter Property="Background" Value="#4080FF" />
						<Setter Property="Foreground" Value="White" />
					</Style>
				</ListBox.Styles>
			</ListBox>
			<Button
			Grid.Row="1"
			Margin="0,0,0,5"
			HorizontalAlignment="Right"
			Command="{Binding SendFileCommand}"
			Content="发送文件" />
		</Grid>

		<!--  接收任务  -->
		<Grid Grid.Row="2" RowDefinitions="Auto,1*">
			<TextBlock
			Margin="0,0,0,5"
			FontSize="16"
			FontWeight="Bold"
			Text="接收任务" />
			<ListBox Grid.Row="1" ItemsSource="{Binding ReceivedTransferTasks}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid Margin="5" ColumnDefinitions="1.2*,*,140,40" RowDefinitions="1.5*,1*">
							<TextBlock FontWeight="Bold" Text="{Binding FileName}" />
							<TextBlock Grid.Row="1" FontSize="12" Text="{Binding StatusText}" />
							<ProgressBar Grid.Column="1"
										 HorizontalAlignment="Stretch"
										 Height="10"
										 MinWidth="20"
										 Margin="5,0"
										 Maximum="{Binding FileSize}"
										 Value="{Binding TransferredSize}" />
							<TextBlock  Margin="5,0,0,0" Grid.Row="1" Grid.Column="1" FontSize="12">
								<Run Text="{Binding FormattedTransferredSize}"/>
								<Run Text="/"/>
								<Run Text="{Binding FormattedFileSize}"/>
							</TextBlock>

							<!--  只有待处理的任务才显示接受/拒绝按钮  -->
							<Grid Margin="5 0" Grid.Column="2" Grid.RowSpan="2" ColumnDefinitions="Auto,Auto">
								<Button
								Grid.Column="0"
								Margin="0 0 5 0"
								Command="{Binding $parent[Window].DataContext.AcceptTransferCommand}"
								CommandParameter="{Binding}"
								Content="接受"
								IsVisible="{Binding Status, Converter={x:Static converters:StatusToVisibilityConverter.Instance}}" />
								<Button
								Grid.Column="1"
								Margin="0 0 5 0"
								Command="{Binding $parent[Window].DataContext.RejectTransferCommand}"
								CommandParameter="{Binding}"
								Content="拒绝"
								IsVisible="{Binding Status, Converter={x:Static converters:StatusToVisibilityConverter.Instance}}" />
							</Grid>
							<Button Grid.Column="3" Grid.RowSpan="2" Content="×" Command="{Binding $parent[Window].DataContext.RemoveTransferCommand}" CommandParameter="{Binding}" Classes="red-button"/>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>

		<!--  发送任务  -->
		<Grid Grid.Row="3" RowDefinitions="Auto,1*">
			<TextBlock
			Margin="0,0,0,5"
			FontSize="16"
			FontWeight="Bold"
			Text="发送任务" />
			<ListBox Grid.Row="1" ItemsSource="{Binding SentTransferTasks}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid Margin="5" ColumnDefinitions="1.2*,*,140,40" RowDefinitions="1.5*,1*">
							<TextBlock FontWeight="Bold" Text="{Binding FileName}" />
							<TextBlock Grid.Row="1" FontSize="12" Text="{Binding StatusText}" />
							<ProgressBar Grid.Column="1"
										 HorizontalAlignment="Stretch"
										 Height="10"
										 MinWidth="20"
										 Margin="5,0"
										 Maximum="{Binding FileSize}"
										 Value="{Binding TransferredSize}" />
							<TextBlock  Margin="5,0,0,0" Grid.Row="1" Grid.Column="1" FontSize="12">
								<Run Text="{Binding FormattedTransferredSize}"/>
								<Run Text="/"/>
								<Run Text="{Binding FormattedFileSize}"/>
							</TextBlock>
							<Button Grid.Column="3" Grid.RowSpan="2" Content="×" Command="{Binding $parent[Window].DataContext.RemoveTransferCommand}" CommandParameter="{Binding}" Classes="red-button"/>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>
	</Grid>

</Window>
