<Window
    x:Class="FileShare.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FileShare.Desktop.ViewModels"
    Title="FileShare.Desktop"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">

    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <!--<TextBlock
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Text="{Binding Greeting}" />-->
    <Grid
        Margin="10"
        ColumnDefinitions="1*"
        RowDefinitions="Auto,1*,1*">
        <!--  状态栏  -->
        <!--<Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>-->
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>-->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,10"
            ColumnDefinitions="1*,Auto">
            <TextBlock
                FontSize="14"
                Foreground="DarkBlue"
                Text="{Binding StatusMessage}" />
            <Button
                Margin="10,0,0,0"
                Command="{Binding RefreshDevicesCommand}"
                Content="刷新设备"
                IsEnabled="{Binding !IsScanning}" />
        </Grid>

        <!--  设备列表  -->
        <Grid
            Grid.Row="1"
            Margin="0,10,0,10"
            RowDefinitions="Auto,1*">
            <!--<Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>-->
            <TextBlock
                Margin="0,0,0,5"
                FontSize="16"
                FontWeight="Bold"
                Text="可用设备" />
            <ListBox
                Grid.Row="1"
                ItemsSource="{Binding Devices}"
                SelectedItem="{Binding SelectedDevice}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock FontWeight="Bold" Text="{Binding DeviceName}" />
                            <TextBlock Margin="5,0,0,0" Text=" ({Binding DeviceType})" />
                            <TextBlock Margin="5,0,0,0" Text=" - " />
                            <TextBlock Margin="0,0,0,0" Text="{Binding IpAddress}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="#4080FF" />
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                </ListBox.Styles>
            </ListBox>
            <Button
                Grid.Row="1"
                Margin="0,0,0,5"
                HorizontalAlignment="Right"
                Command="{Binding SendFileCommand}"
                Content="发送文件" />
        </Grid>

        <!--  传输任务  -->
        <Grid Grid.Row="2" RowDefinitions="Auto,1*">
            <!--<Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>-->
            <TextBlock
                Margin="0,0,0,5"
                FontSize="16"
                FontWeight="Bold"
                Text="传输任务" />
            <ListBox Grid.Row="1" ItemsSource="{Binding TransferTasks}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="1*,Auto,Auto,Auto">
                            <StackPanel Margin="5" Orientation="Vertical">
                                <TextBlock FontWeight="Bold" Text="{Binding FileName}" />
                                <ProgressBar
                                    Width="300"
                                    Height="10"
                                    Margin="0,5,0,0"
                                    Maximum="{Binding FileSize}"
                                    Value="{Binding TransferredSize}" />
                                <TextBlock FontSize="12" Text="{Binding Status}" />
                            </StackPanel>

                            <!--  只有待处理的任务才显示接受/拒绝按钮  -->
                            <Button
                                Grid.Column="1"
                                Margin="5"
                                Command="{Binding $parent[Window].DataContext.AcceptTransferCommand}"
                                CommandParameter="{Binding}"
                                Content="接受" />
                            <Button
                                Grid.Column="2"
                                Margin="5"
                                Command="{Binding $parent[Window].DataContext.RejectTransferCommand}"
                                CommandParameter="{Binding}"
                                Content="拒绝" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>

</Window>
