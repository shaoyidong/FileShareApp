<Window
    x:Class="FileShare.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:FileShare.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="using:FileShare.Desktop.Assets.Fonts"
    xmlns:local="using:FileShare.Desktop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FileShare.Desktop.ViewModels"
    Title="局域网文件传输"
    d:DesignHeight="600"
    d:DesignWidth="900"
    x:DataType="vm:MainViewModel"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">
    <Window.Styles>
        <Style Selector="Button.red-button">
            <Setter Property="Foreground" Value="Red" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.red-button:pointerover /template/ ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="Red" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.red-button:pressed /template/ ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="Red" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.primary-button">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.secondary-button">
            <Setter Property="Background" Value="#E6E6E6" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.accept-button">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.reject-button">
            <Setter Property="Background" Value="#E6E6E6" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.icon-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="Button.fluentIcon-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Window.Styles>
    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainViewModel />
    </Design.DataContext>
    <Grid>
        <!--  Main Content  -->
        <ContentControl Content="{Binding CurrentView}" />
    </Grid>
</Window>
