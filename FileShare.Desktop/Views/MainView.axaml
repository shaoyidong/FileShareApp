<UserControl
    x:Class="FileShare.Desktop.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FileShare.Desktop.Localization"
    xmlns:converters="using:FileShare.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="using:FileShare.Desktop.Assets.Fonts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FileShare.Desktop.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="960"
    x:CompileBindings="True"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*,Auto">

        <!--  工具栏：设备刷新 / IP 直连 / 网段扫描  -->
        <Border Grid.Row="0" Classes="toolbar" Padding="8,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        Classes="icon"
                        Command="{Binding RefreshDevicesCommand}"
                        ToolTip.Tip="{loc:Tr '重新广播并收集设备'}">
                        <TextBlock
                            Classes="iconGlyph"
                            Text="{x:Static fonts:FluentUI.arrow_sync_24_regular}" />
                    </Button>

                    <Border Classes="separator" Height="20" />

                    <TextBlock Classes="label" Text="{loc:Tr 'IP 直连'}" />
                    <TextBox
                        Width="170"
                        Watermark="192.168.1.20:5237"
                        Text="{Binding ManualAddress}" />
                    <Button
                        MinWidth="56"
                        Command="{Binding ConnectByAddressCommand}"
                        Content="{loc:Tr '连接'}"
                        IsEnabled="{Binding !IsConnecting}" />

                    <Border Classes="separator" Height="20" />

                    <TextBlock Classes="label" Text="{loc:Tr '网段扫描'}" />
                    <TextBox
                        Width="140"
                        Watermark="192.168.1.0/24"
                        Text="{Binding SubnetCidr}" />
                    <Button
                        MinWidth="56"
                        Command="{Binding ScanSubnetCommand}"
                        Content="{loc:Tr '扫描'}"
                        IsVisible="{Binding !IsSubnetScanning}" />
                    <Button
                        MinWidth="56"
                        Command="{Binding CancelSubnetScanCommand}"
                        Content="{loc:Tr '停止'}"
                        IsVisible="{Binding IsSubnetScanning}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        Classes="icon"
                        Command="{Binding ShowSettingsCommand}"
                        ToolTip.Tip="{loc:Tr '设置（设备名 / 保存目录 / 皮肤）'}">
                        <TextBlock
                            Classes="iconGlyph"
                            Text="{x:Static fonts:FluentUI.settings_24_regular}" />
                    </Button>
                    <Button
                        Classes="icon"
                        Command="{Binding ShowHistoryCommand}"
                        ToolTip.Tip="{loc:Tr '接收历史'}">
                        <TextBlock
                            Classes="iconGlyph"
                            Text="{x:Static fonts:FluentUI.history_24_regular}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  主体：左侧设备列表，右侧传输任务  -->
        <Grid Grid.Row="1" Margin="8" ColumnDefinitions="300,*">

            <Border
                Grid.Column="0"
                Margin="0,0,8,0"
                Padding="8"
                Classes="panel">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="h1" Text="{loc:Tr '附近设备'}" />
                        <TextBlock
                            Grid.Column="2"
                            Classes="muted"
                            Text="{Binding DeviceCountText}" />
                    </Grid>

                    <ListBox
                        Grid.Row="1"
                        Margin="0,6,0,0"
                        ItemsSource="{Binding Devices}"
                        SelectedItem="{Binding SelectedItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceItemViewModel">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="Bold"
                                            Text="{Binding DeviceName}" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Classes="muted"
                                            Text="{Binding MetaText}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Classes="icon"
                                        Command="{Binding $parent[UserControl].DataContext.ToggleFavoriteCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{loc:Tr '收藏（可自动接收其文件）'}">
                                        <Grid>
                                            <TextBlock
                                                Classes="star"
                                                IsVisible="{Binding IsFavorite}"
                                                Text="★" />
                                            <TextBlock
                                                Classes="starOff"
                                                IsVisible="{Binding IsNotFavorite}"
                                                Text="☆" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        Spacing="6">
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Classes="accent"
                            Command="{Binding SendFilesCommand}"
                            Content="{loc:Tr '发送文件（可多选）'}"
                            IsEnabled="{Binding IsDeviceSelected}" />
                        <Grid ColumnDefinitions="*,8,*">
                            <Button
                                Grid.Column="0"
                                HorizontalContentAlignment="Center"
                                Command="{Binding SendFolderCommand}"
                                Content="{loc:Tr '发送文件夹'}"
                                IsEnabled="{Binding IsDeviceSelected}"
                                ToolTip.Tip="{loc:Tr '递归发送整个文件夹，并在对端保留目录结构'}" />
                            <Button
                                Grid.Column="2"
                                HorizontalContentAlignment="Center"
                                Command="{Binding SendTextCommand}"
                                Content="{loc:Tr '发送文本'}"
                                IsEnabled="{Binding IsDeviceSelected}"
                                ToolTip.Tip="{loc:Tr '对端会收到一个 .txt 文件'}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,6,*,6,*" IsVisible="{Binding IsSending}">
                            <Button
                                Grid.Column="0"
                                HorizontalContentAlignment="Center"
                                Command="{Binding PauseSendCommand}"
                                Content="{loc:Tr '暂停'}"
                                IsEnabled="{Binding !IsSendPaused}"
                                ToolTip.Tip="{loc:Tr '当前文件传完后暂停'}" />
                            <Button
                                Grid.Column="2"
                                HorizontalContentAlignment="Center"
                                Command="{Binding ResumeSendCommand}"
                                Content="{loc:Tr '继续'}"
                                IsEnabled="{Binding IsSendPaused}" />
                            <Button
                                Grid.Column="4"
                                HorizontalContentAlignment="Center"
                                Command="{Binding CancelSendCommand}"
                                Content="{loc:Tr '取消'}" />
                        </Grid>
                        <TextBlock
                            Classes="muted"
                            Text="{Binding LocalDeviceSummary}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="muted"
                            Text="{loc:Tr '提示：可以把文件或文件夹直接拖进窗口发送。'}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="8" Classes="panel">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="h1" Text="{loc:Tr '传输任务'}" />
                    </Grid>

                    <!--  待发送队列（可重排）  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,6,0,0"
                        Padding="8"
                        Classes="card"
                        IsVisible="{Binding HasQueue}">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="h1" Text="{loc:Tr '待发送队列'}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Classes="muted"
                                    Text="{Binding QueueCountText}" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" MaxHeight="120" Margin="0,4,0,0">
                                <ItemsControl ItemsSource="{Binding SendQueue}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SendQueueItemViewModel">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,1">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Margin="0,0,60,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Classes="muted"
                                                    Text="{Binding SizeText}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Classes="icon"
                                                    Command="{Binding $parent[UserControl].DataContext.MoveQueueUpCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="↑"
                                                    ToolTip.Tip="{loc:Tr '上移'}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="icon"
                                                    Command="{Binding $parent[UserControl].DataContext.MoveQueueDownCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="↓"
                                                    ToolTip.Tip="{loc:Tr '下移'}" />
                                                <Button
                                                    Grid.Column="3"
                                                    Classes="danger"
                                                    Command="{Binding $parent[UserControl].DataContext.RemoveQueueItemCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="✕"
                                                    ToolTip.Tip="{loc:Tr '从队列移除'}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <ScrollViewer
                        Grid.Row="2"
                        Margin="0,6,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TransferTasks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileTransferViewModel">
                                    <Border Padding="8" Classes="card">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{Binding Direction, Converter={x:Static converters:TransferDirectionToColorConverter.Instance}}"
                                                    Text="{Binding DirectionText}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    Text="{Binding FileName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Classes="danger"
                                                    Command="{Binding $parent[UserControl].DataContext.RemoveTransferCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="✕"
                                                    ToolTip.Tip="{loc:Tr '移除任务'}" />
                                            </Grid>

                                            <Grid
                                                Grid.Row="1"
                                                Margin="0,6,0,0"
                                                ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock
                                                    Classes="muted"
                                                    Foreground="{Binding Status, Converter={x:Static converters:StatusToColorConverter.Instance}}"
                                                    Text="{Binding StatusText}" />
                                                <StackPanel
                                                    Grid.Column="2"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Classes="muted"
                                                        Text="{Binding FormattedTransferredSize}" />
                                                    <TextBlock
                                                        Margin="2,0"
                                                        Classes="muted"
                                                        Text="/" />
                                                    <TextBlock
                                                        Classes="muted"
                                                        Text="{Binding FormattedFileSize}" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        Classes="accent"
                                                        IsVisible="{Binding ShowSpeed}"
                                                        Text="{Binding SpeedText}" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid
                                                Grid.Row="2"
                                                Margin="0,6,0,0"
                                                ColumnDefinitions="*,Auto">
                                                <ProgressBar
                                                    VerticalAlignment="Center"
                                                    Maximum="100"
                                                    Value="{Binding ProgressPercentage}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Width="46"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Classes="muted"
                                                    Text="{Binding ProgressPercentage, StringFormat={}{0:F1}%}"
                                                    TextAlignment="Right" />
                                            </Grid>

                                            <!--  发送失败：重试（接收端会续传）  -->
                                            <StackPanel
                                                Grid.Row="3"
                                                Margin="0,8,0,0"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                IsVisible="{Binding CanRetry}">
                                                <Button
                                                    MinWidth="64"
                                                    Classes="accent"
                                                    Command="{Binding $parent[UserControl].DataContext.RetryTransferCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{loc:Tr '重试'}" />
                                            </StackPanel>

                                            <!--  接收请求：接受 / 拒绝  -->
                                            <StackPanel
                                                Grid.Row="3"
                                                Margin="0,8,0,0"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                IsVisible="{Binding ShowAcceptReject}">
                                                <Button
                                                    MinWidth="64"
                                                    Classes="accent"
                                                    Command="{Binding $parent[UserControl].DataContext.AcceptTransferCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{loc:Tr '接受'}" />
                                                <Button
                                                    MinWidth="64"
                                                    Command="{Binding $parent[UserControl].DataContext.RejectTransferCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{loc:Tr '拒绝'}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="muted"
                        IsVisible="{Binding !HasTransferTasks}"
                        Text="{loc:Tr '暂无传输任务：选择左侧设备后点击「发送文件」'}" />
                </Grid>
            </Border>
        </Grid>

        <!--  状态栏  -->
        <Border Grid.Row="2" Padding="8,3" Classes="statusbar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis" />
                <ProgressBar
                    Grid.Column="2"
                    Width="160"
                    Height="10"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsSubnetScanning}"
                    Maximum="100"
                    Value="{Binding SubnetScanProgress}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
