<UserControl
    x:Class="FileShare.Desktop.Views.SendTextView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FileShare.Desktop.Localization"
    xmlns:vm="using:FileShare.Desktop.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="vm:SendTextViewModel"
    Width="540"
    Height="400"
    MinWidth="420"
    MinHeight="300"
    d:DesignWidth="540"
    d:DesignHeight="400"
    mc:Ignorable="d">

    <!--  内容弹窗（仿 Prism ShowDialog）：本视图由 DialogService 放进 DialogWindow 宿主显示，
         标题栏由宿主窗口承担（Title = SendTextViewModel.Title），视图只保留编辑区与按钮栏  -->
    <Grid RowDefinitions="*,Auto">

        <TextBox
            Grid.Row="0"
            Margin="12"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            VerticalContentAlignment="Top"
            Watermark="{loc:Tr '在这里输入要发送的文本，将以文本消息发送，对端可直接复制全文'}"
            Text="{Binding Text}" />

        <Border
            Grid.Row="1"
            Padding="10,8"
            Classes="statusbar">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="muted"
                    TextTrimming="CharacterEllipsis"
                    Text="{Binding TargetText}" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        MinWidth="84"
                        Classes="accent"
                        Command="{Binding SendCommand}"
                        Content="{loc:Tr '发送'}" />
                    <Button
                        MinWidth="84"
                        Command="{Binding CancelCommand}"
                        Content="{loc:Tr '取消'}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
