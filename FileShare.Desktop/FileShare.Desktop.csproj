<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<AvaloniaXamlCompilerLogLevel>Diagnostic</AvaloniaXamlCompilerLogLevel>
		<!--<PublishAot>True</PublishAot>-->
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="Models\" />
		<AvaloniaResource Include="Assets\**" />
		<AvaloniaResource Remove="Assets\Fonts\FluentUI.cs" />
		<Folder Include="runtimes\linux-arm64\native\" />
		<Folder Include="runtimes\linux-arm\native\" />
		<Folder Include="runtimes\osx-arm64\native\" />
		<Folder Include="runtimes\osx-x64\native\" />
		<Folder Include="runtimes\win-arm64\native\" />
		<Folder Include="runtimes\win-arm\native\" />
		<Folder Include="runtimes\win-x86\native\" />
	</ItemGroup>

	<ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
		<EmbeddedResource Include="runtimes\$(RuntimeIdentifier)\native\*">
			<LogicalName>%(FileName)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!-- 定义一个目标，在发布流程的核心步骤之前运行 -->
	<!--<Target Name="EmbedNativeLibrariesForPublish"  BeforeTargets="IlcCompile">
		<Message Text="=== 开始为发布嵌入本机库 ===" Importance="high" />
		<Message Text="当前 RuntimeIdentifier: $(RuntimeIdentifier)" Importance="high" />

		--><!-- 检查目标平台的原生库目录是否存在 --><!--
