			<_NativeLibSourceDir>runtimes\$(RuntimeIdentifier)\native</_NativeLibSourceDir>
		</PropertyGroup>

		<Message Text="正在查找库文件: $(_NativeLibSourceDir)" Importance="high" />

		--><!--<ItemGroup>
